# Quantidade de fotos esperada por operação antes de disparar o processamento.
BATCH_SIZE=5

# Tempo de inatividade (segundos) até um lote incompleto expirar e reiniciar do zero.
BATCH_TTL_SECONDS=900

# "memory" (padrão, simples) ou "redis" (recomendado em produção).
STORE_BACKEND=memory
REDIS_URL=redis://redis:6379/0

# Idiomas do OCR (pacotes de idioma do tesseract, separados por "+").
OCR_LANG=por+eng

# Tempo (segundos) que uma pergunta pendente (booking/cliente, ou "usar a
# mesma reserva?") fica aberta esperando resposta no grupo.
CONVERSATION_TTL_SECONDS=1800

# --- Supabase (estoque de flex tank importado do Google Sheets + dashboard) ---
# Rode config/supabase_schema.sql no seu projeto antes de configurar isto.
# Use a SERVICE ROLE KEY (não a anon key) — o backend precisa poder
# inserir/atualizar ignorando RLS. Deixe em branco para rodar sem Supabase
# (a extração e o PDF continuam funcionando; só não consulta/baixa estoque
# nem grava o dashboard).
SUPABASE_URL=
SUPABASE_KEY=

# Nomes de tabela/coluna da planilha de estoque (ajuste para bater com a
# tabela real importada do Google Sheets — ver comentários em
# config/supabase_schema.sql).
SUPABASE_ESTOQUE_TABLE=estoque_flex
SUPABASE_ESTOQUE_COL_FLEX_NUMBER=numero_flex
SUPABASE_ESTOQUE_COL_STATUS=status
SUPABASE_ESTOQUE_STATUS_EM_ESTOQUE=em_estoque
SUPABASE_ESTOQUE_STATUS_BAIXADO=baixado

# Tabela (de propriedade deste serviço) e bucket de Storage do dashboard do cliente.
SUPABASE_OPERACOES_TABLE=operacoes
SUPABASE_STORAGE_BUCKET=fotos-operacoes

# --- Evolution API (provedor de WhatsApp que suporta grupos) ---

# Chave de autenticação da API do Evolution (gere uma senha forte sua).
EVOLUTION_API_KEY=troque-esta-chave

# Credenciais do Postgres usado pelo Evolution API para guardar as instâncias.
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DATABASE=evolution

# URL do webhook do n8n (workflow importado) que vai receber as mensagens do
# grupo. Se o n8n estiver rodando em outro host/porta, ajuste aqui.
N8N_WHATSAPP_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-in
