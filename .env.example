# Quantidade de fotos esperada por operação antes de disparar o processamento.
BATCH_SIZE=5

# Tempo de inatividade (segundos) até um lote incompleto expirar e reiniciar do zero.
BATCH_TTL_SECONDS=900

# "memory" (padrão, simples) ou "redis" (recomendado em produção).
STORE_BACKEND=memory
REDIS_URL=redis://redis:6379/0

# Idiomas do OCR (pacotes de idioma do tesseract, separados por "+").
OCR_LANG=por+eng

# --- Evolution API (provedor de WhatsApp que suporta grupos) ---

# Chave de autenticação da API do Evolution (gere uma senha forte sua).
EVOLUTION_API_KEY=troque-esta-chave

# Credenciais do Postgres usado pelo Evolution API para guardar as instâncias.
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DATABASE=evolution

# URL do webhook do n8n (workflow importado) que vai receber as mensagens do
# grupo. Se o n8n estiver rodando em outro host/porta, ajuste aqui.
N8N_WHATSAPP_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-in
