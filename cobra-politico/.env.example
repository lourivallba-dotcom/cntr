# ---- Básico ----
NODE_ENV=production
PORT=3000
# URL pública do site (usada nos links dos e-mails e nos callbacks de login)
BASE_URL=https://cobrapolitico.com.br
SITE_NOME=Cobra Político
# E-mails (separados por vírgula) que podem ocultar/republicar conteúdo
ADMIN_EMAILS=

# ---- Login social ----
# Google: console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth
#   URI de redirecionamento: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: developers.facebook.com > App > Login do Facebook
#   URI de redirecionamento: ${BASE_URL}/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram: developers.facebook.com > App > Instagram > "API com login do Instagram"
#   URI de redirecionamento: ${BASE_URL}/auth/instagram/callback
#   (só contas profissionais; o Instagram não fornece e-mail)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Login de teste sem rede social (NUNCA ligue em produção)
ALLOW_DEV_LOGIN=0

# ---- E-mail ----
# ex.: smtps://usuario:senha@smtp.seuprovedor.com:465  (sem isto os e-mails são só registrados no banco)
SMTP_URL=
EMAIL_FROM=Cobra Político <nao-responda@cobrapolitico.com.br>
EMAIL_REPLY_TO=

# ---- Divulgação automática nas redes ----
# Webhook (n8n/Make/Zapier) chamado com JSON quando há nova cobrança ou resposta
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_TOKEN=

# ---- Dados ----
# 1 = usa políticos FICTÍCIOS (só para desenvolvimento sem internet)
DADOS_OFFLINE=0
CACHE_HORAS=12
VIDEO_MAX_MB=150
# DB_PATH=/dados/cobra-politico.sqlite
# UPLOADS_DIR=/dados/uploads
