    {
      "parameters": {
        "jsCode": "// Monta a pergunta obrigatória de booking/cliente (1ª operação do chat) ou a\n// pergunta de \"quer reaproveitar a reserva anterior?\" (operações seguintes).\nconst r = $input.first().json;\nconst p = r.extraction_preview;\nconst header = `📦 Fotos recebidas e identificadas!\\nContêiner: ${p.container_number ?? 'NÃO IDENTIFICADO'}${p.container_number_check_digit_valid === false ? ' (CONFERIR dígito verificador)' : ''}\\nFlex Tank: ${p.flex_number ?? 'NÃO IDENTIFICADO'}`;\n\nlet question;\nif (r.needs_answer === 'awaiting_booking_cliente') {\n  question = `${header}\\n\\nQual é a reserva (booking) e o cliente dessa operação? Responda no formato:\\n\"Booking XXXXX, cliente YYYYY\"`;\n} else {\n  question = `${header}\\n\\nDeseja usar a mesma reserva e cliente da operação anterior?\\nBooking ${r.previous_booking} · Cliente ${r.previous_cliente}\\nResponda \"sim\" ou informe a nova reserva/cliente.`;\n}\n\nreturn [{ json: { chat_id: r.chat_id, text: question } }];\n"
      },
      "id": "ask-question",
      "name": "Monta pergunta (booking/cliente)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, -380]
    },
