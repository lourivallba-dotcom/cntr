    {
      "parameters": {
        "jsCode": "// Normaliza o payload recebido do provedor de WhatsApp para um formato único.\n// Ajuste este bloco conforme o JSON real que seu provedor envia no webhook\n// (Evolution API, WAHA e Baileys têm formatos ligeiramente diferentes).\nconst body = $input.first().json.body ?? $input.first().json;\n\n// --- Exemplo assumindo formato estilo Evolution API ---\nconst messageType = body?.message?.type ?? body?.type ?? 'unknown';\nconst chatId = body?.message?.chatId ?? body?.chatId ?? body?.from;\nconst isImage = messageType === 'image' || messageType === 'imageMessage';\nconst isText = messageType === 'text' || messageType === 'conversation' || messageType === 'extendedTextMessage';\nconst text = (body?.message?.text ?? body?.text ?? '').trim();\nconst mediaBase64 = body?.message?.base64 ?? body?.base64 ?? null;\nconst mediaMimeType = body?.message?.mimetype ?? body?.mimetype ?? 'image/jpeg';\nconst filename = body?.message?.filename ?? `foto_${Date.now()}.jpg`;\n\nreturn [{\n  json: {\n    ...($input.first().json),\n    chat_id: chatId,\n    message_type: messageType,\n    is_image: isImage,\n    is_text: isText,\n    text,\n    media_base64: mediaBase64,\n    media_mime_type: mediaMimeType,\n    filename,\n  },\n}];\n"
      },
      "id": "normalize",
      "name": "Extrai dados da mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-720, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
