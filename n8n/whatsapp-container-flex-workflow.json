    {
      "parameters": {
        "jsCode": "// Monta o texto do e-mail, a resposta no grupo e a lista de contatos pra DM,\n// a partir do resultado final (\"finalize\") devolvido por /chats/{chat_id}/answer.\nconst f = $json.finalize;\nconst config = $('Config').first().json;\nconst chatId = $('Extrai dados da mensagem').item.json.chat_id;\n\nconst estoqueTxt = f.flex_em_estoque === true\n  ? 'encontrado no estoque e baixado ✅'\n  : f.flex_em_estoque === false\n    ? '⚠️ NÃO CONSTA na base de estoque — conferir manualmente'\n    : 'estoque não consultado';\n\nconst warningsText = (f.warnings || []).length ? `\\n⚠️ ${f.warnings.join(', ')}` : '';\n\nconst summary = `📦 Contêiner: ${f.container_number ?? 'NÃO IDENTIFICADO'}\\nFlex Tank: ${f.flex_number ?? 'NÃO IDENTIFICADO'}\\nBooking: ${f.booking} · Cliente: ${f.cliente}\\nEstoque: ${estoqueTxt}${warningsText}`;\n\nconst contacts = (config.responsible_phones || '').split(',').map((p) => p.trim()).filter(Boolean);\n\nreturn [{\n  json: {\n    ...f,\n    chat_id: chatId,\n    reply_text: `${summary}\\n\\n📧 E-mail enviado com o relatório em PDF.`,\n    email_subject: `Contêiner ${f.container_number ?? 'S/N'} / Flex ${f.flex_number ?? 'S/N'} — Booking ${f.booking}`,\n    email_body: summary,\n    email_to: config.email_to,\n    contacts,\n  },\n}];\n"
      },
      "id": "build-final",
      "name": "Monta e-mail, resposta e lista de DM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 200]
    },
    {
      "parameters": {
        "jsCode": "const buffer = Buffer.from($json.pdf_base64, 'base64');\nconst binary = await this.helpers.prepareBinaryData(buffer, $json.pdf_filename, 'application/pdf');\nreturn [{ json: $json, binary: { pdf: binary } }];\n"
      },
