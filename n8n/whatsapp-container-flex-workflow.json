      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-680, 0]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o payload recebido do provedor de WhatsApp para um formato único.\n// Ajuste este bloco conforme o JSON real que seu provedor envia no webhook\n// (Evolution API, WAHA e Baileys têm formatos ligeiramente diferentes).\nconst body = $input.first().json.body ?? $input.first().json;\n\n// --- Exemplo assumindo formato estilo Evolution API ---\nconst messageType = body?.message?.type ?? body?.type ?? 'unknown';\nconst chatId = body?.message?.chatId ?? body?.chatId ?? body?.from;\nconst isImage = messageType === 'image' || messageType === 'imageMessage';\nconst text = body?.message?.text ?? body?.text ?? '';\nconst mediaBase64 = body?.message?.base64 ?? body?.base64 ?? null;\nconst mediaMimeType = body?.message?.mimetype ?? body?.mimetype ?? 'image/jpeg';\nconst filename = body?.message?.filename ?? `foto_${Date.now()}.jpg`;\n\nreturn [{\n  json: {\n    ...($input.first().json),\n    chat_id: chatId,\n    message_type: messageType,\n    is_image: isImage,\n    text,\n    media_base64: mediaBase64,\n    media_mime_type: mediaMimeType,\n    filename,\n  },\n}];\n"
      },
      "id": "normalize",
      "name": "Extrai dados da mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-460, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-group",
              "leftValue": "={{$json.chat_id}}",
              "rightValue": "={{$('Config').first().json.group_id}}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-image",
              "leftValue": "={{$json.is_image}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-image-from-group",
      "name": "É foto do grupo alvo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst buffer = Buffer.from(item.media_base64, 'base64');\nconst binary = await this.helpers.prepareBinaryData(buffer, item.filename, item.media_mime_type);\nreturn [{ json: item, binary: { file: binary } }];\n"
      },
      "id": "base64-to-binary",
      "name": "Base64 -> binário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Config').first().json.cntr_vision_base_url}}/batches/{{$json.chat_id}}/images",
        "sendBinaryData": true,
        "binaryPropertyName": "file",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": []
        },
        "options": {}
