      "id": "if-ready",
      "name": "Lote completo (5 fotos)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [420, 0]
    },
    {
      "parameters": {
        "jsCode": "// Converte as 5 fotos (base64) devolvidas pelo cntr-vision em anexos binários\n// para o node de e-mail, e monta o texto da mensagem de resposta no grupo.\nconst result = $input.first().json.result;\nconst config = $('Config').first().json;\n\nconst binary = {};\nfor (const img of result.images) {\n  const buffer = Buffer.from(img.content_b64, 'base64');\n  binary[`anexo_${img.index}_${img.role}`] = await this.helpers.prepareBinaryData(\n    buffer,\n    img.filename,\n    img.content_type,\n  );\n}\n\nconst mentions = config.responsible_phones.split(',').map((p) => p.trim()).filter(Boolean);\nconst mentionText = mentions.map((p) => `@${p}`).join(' ');\n\nconst warningsText = (result.warnings || []).length\n  ? `\\n\\n⚠️ Atenção, conferir manualmente: ${result.warnings.join(', ')}`\n  : '';\n\nconst replyText = `📦 Novo lote recebido\\nContêiner: ${result.container_number ?? 'NÃO IDENTIFICADO'}\\nFlex Tank: ${result.flex_number ?? 'NÃO IDENTIFICADO'}${warningsText}\\n\\n${mentionText}`;\n\nconst emailSubject = `Contêiner ${result.container_number ?? 'S/N'} / Flex ${result.flex_number ?? 'S/N'}`;\nconst emailBody = `Segue em anexo o registro fotográfico da operação.\\n\\nContêiner: ${result.container_number ?? 'não identificado'} (${result.container_number_check_digit_valid ? 'dígito verificador OK' : 'CONFERIR dígito verificador'})\\nFlex Tank / Processo: ${result.flex_number ?? 'não identificado'} (fonte: ${result.flex_number_source ?? '-'})${warningsText}`;\n\nreturn [{\n  json: {\n    ...result,\n    reply_text: replyText,\n    mentions,\n    email_subject: emailSubject,\n    email_body: emailBody,\n    email_to: config.email_to,\n  },\n  binary,\n}];\n"
      },
      "id": "prepare-output",
      "name": "Monta e-mail e resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, -120]
    },
